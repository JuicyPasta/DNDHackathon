<%- include("header.ejs") -%>
<%
   var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
   function when(iso) { var d = new Date(iso); return months[d.getUTCMonth()] + ' ' + d.getUTCFullYear(); }
   function gradeColor(g) { return { A: '#5fae6a', B: '#5fae6a', C: '#f0d634', D: '#d43c3c', F: '#d43c3c' }[g] || '#9aa1a6'; }
   function short(s) { s = s.replace(/\s+/g, ' ').trim(); return s.length > 260 ? s.slice(0, 260).replace(/\s\S*$/, '') : s; }
   var mean = parseFloat(t.overall.mean) || 0;
   var maxGrade = Math.max(1, t.grades.A, t.grades.B, t.grades.C, t.grades.D, t.grades.F);
%>
<style>
   .profHeader {
      position: relative;
      background: url('/images/backgroundphoto.png') center / cover;
      color: white;
      padding: 25px 40px 40px;
   }
   .profHeader:before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(30, 30, 30, .55);
      backdrop-filter: blur(6px);
   }
   .profHeader > * { position: relative; }
   .profHeader > .logoLink, .collegeHeader > .logoLink { position: absolute; left: 30px; top: 25px; }
   .smallLogo { width: 60px; }
   .profInfo { display: flex; align-items: center; margin-top: 30px; }
   .profPic {
      width: 190px; height: 190px; border-radius: 50%;
      object-fit: cover; border: 4px solid rgba(255,255,255,.85);
      margin-right: 35px; background: white;
   }
   .profName { font-size: 44px; font-weight: bold; margin: 0; }
   .profDept { font-size: 28px; margin: 4px 0 10px; }
   .bars { display: inline-block; vertical-align: middle; }
   .bars span {
      display: inline-block; width: 34px; height: 34px; margin-right: 3px;
      background: rgba(255,255,255,.25);
   }
   .bars span .fill { display: block; height: 100%; background: #f2d633; }
   .evals { font-size: 26px; vertical-align: middle; margin-left: 10px; }
   .tags { margin-top: 10px; }
   .tags span { display: inline-block; background: rgba(0,176,101,.85); border-radius: 12px; padding: 2px 12px; margin-right: 6px; font-size: 14px; }

   .statsRow { display: flex; justify-content: center; flex-wrap: wrap; padding: 30px 20px 0; }
   .statBox { width: 320px; margin: 0 25px; font-size: 17px; }
   .statBox h3 { font-weight: bold; font-size: 22px; }
   .statLine { display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 6px 0; }
   .gradeBar { display: flex; align-items: center; margin: 4px 0; }
   .gradeBar b { width: 24px; }
   .gradeBar .bar { height: 16px; background: rgb(0, 176, 101); margin-right: 8px; border-radius: 3px; }
   .cloudBox img { width: 340px; height: 340px; border: 1px solid #ddd; border-radius: 6px; }

   .reviews { max-width: 1000px; margin: 30px auto 60px; }
   .reviews > h1 { text-align: center; font-size: 48px; margin-bottom: 20px; }
   .review { display: flex; align-items: center; border-bottom: 1px solid #ccc; padding: 25px 0; }
   .gradeCircle {
      flex: none; width: 120px; height: 120px; border-radius: 50%;
      color: white; font-size: 20px; display: flex; align-items: center; justify-content: center;
      margin-right: 35px;
   }
   .reviewBody { flex: 1; }
   .reviewBody h2 { text-align: center; color: #4a8af4; margin: 0 0 10px; font-size: 32px; }
   .reviewBody p { font-size: 18px; color: #555; }
   .reviewBody .date { color: #888; font-size: 15px; }
   .readMore { color: black; }
</style>

<div class="profHeader">
   <a class="logoLink" href="/"><img class="smallLogo" src="/images/HACK_LOGO_LARGE_WHITE.png"></a>
   <%- include("search.ejs") -%>
   <div class="profInfo">
      <img class="profPic" src="/<%= t.photo %>">
      <div>
         <h1 class="profName"><%= t.teacher %></h1>
         <div class="profDept"><%= t.department %> Professor</div>
         <div class="bars"><% for (var i = 0; i < 4; i++) { %><span><i class="fill" style="width: <%= Math.max(0, Math.min(1, mean - i)) * 100 %>%"></i></span><% } %></div>
         <span class="evals">(<%= t.totalEvals %>)</span>
         <% if (t.tags.length) { %><div class="tags"><% t.tags.forEach(function (tag) { %><span><%= tag %></span><% }) %></div><% } %>
      </div>
   </div>
</div>

<div class="statsRow">
   <div class="statBox">
      <h3>The numbers</h3>
      <div class="statLine"><span>Overall</span><b><%= t.overall.mean %> / 4</b></div>
      <div class="statLine"><span>Presents material clearly</span><b><%= t.presentation.mean %> / 4</b></div>
      <div class="statLine"><span>Gets it when you're struggling</span><b><%= t.understandingness.mean %> / 4</b></div>
      <h3>Grades people got</h3>
      <% ['A', 'B', 'C', 'D', 'F'].forEach(function (g) { %>
      <div class="gradeBar"><b><%= g %></b><div class="bar" style="width: <%= Math.round(200 * t.grades[g] / maxGrade) %>px"></div><%= t.grades[g] %></div>
      <% }) %>
   </div>
   <div class="statBox cloudBox">
      <h3>What people say</h3>
      <img src="/<%= t.cloud %>">
   </div>
</div>

<div class="reviews">
   <h1>Student Reviews</h1>
   <% if (!t.reviews.length) { %>
   <p style="text-align: center">No reviews cached for this one. <a href="<%= t.link %>">Read them on PolyRatings</a>.</p>
   <% } %>
   <% t.reviews.forEach(function (r) { %>
   <div class="review">
      <div class="gradeCircle" style="background: <%= gradeColor(r.grade) %>">Grade:&nbsp;<b><%= r.grade %></b></div>
      <div class="reviewBody">
         <h2><%= r.course %></h2>
         <p>&ldquo;<%= short(r.text) %>&rdquo;<% if (r.text.length > 260) { %>..... <a class="readMore" href="<%= t.link %>">READ MORE</a><% } %></p>
         <div class="date"><%= when(r.date) %></div>
      </div>
   </div>
   <% }) %>
</div>

<%- include("footer.ejs") -%>
