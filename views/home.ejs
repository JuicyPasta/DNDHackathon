<%- include("header.ejs") -%>

<style>
   #logo {
      display: block;
      margin: 0 auto;
      padding-top: 60px;
      width: 500px;
      height: auto;
   }
   #searchGroup {
      margin-top: 60px;
   }
   .college {
      padding: 0;
      width: 100%;
      height: auto;
   }
   #collegesRowOne {
      margin-top: 30px;
   }
   #collegesRowTwo {
      margin-top: 50px;
   }
</style>

<div class="photo first" style="height: 700px" data-stellar-background-ratio="0.5">
   <img id="logo" src="/images/sicklogo.gif">
   <%- include("search.ejs") -%>
</div>
<div class="photo second" style="height: 850px" data-stellar-background-ratio="0.5"><span>
   <div class="container" style="text-align: center; margin-top: 40px; font-size: 40px; font-weight: bold; font: helvetica-neu;">
      <span style="text-align: center; color: black">Colleges
   </div>
   <div class="container" style="width: 100%; padding: 0; margin: 0;">
      <div class="container" id="collegesRowOne">
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/agriculture">
               <img class="college" src="/images/Agriculture, Food, and Enviornmental Sciences02.png"> </img>
            </a>
         </div>
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/architecture">
               <img class="college" src="/images/Architecture and Environmental Design.png"> </img>
            </a>
         </div>
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/business">
               <img class="college" src="/images/Business.png"> </img>
            </a>
         </div>
      </div>
      <div class="container" id="collegesRowTwo">
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/engineering">
               <img class="college" src="/images/Engineering.png"> </img>
            </a>
         </div>
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/liberalArts">
               <img class="college" src="/images/Liberal Arts.png"> </img>
            </a>
         </div>
         <div class="col-xs-4 col-xs-offset-0">
            <a href="/colleges/scienceAndMath">
               <img class="college" src="/images/Science and Mathematics.png"> </img>
            </a>
         </div>
      </div>
   </div>
</span></div>
<div class="photo third" style="height: 400px" data-stellar-background-ratio="0.5"><span>
   <div class="container" style="text-align: center">
      <img src="/images/hack-tagline.png" style="width:500px; height: auto; margin-top: 160px"></img>
   </div>
</span></div>
<div class="photo fourth" data-stellar-background-ratio="0.5" style="background-color: rgb(0, 176, 101); height: 130.859px"><span>
   <div class="container" style="text-align:center; ">
      <img src="/images/hack-footer.png" style="width: 100%; height: auto"> </img>
   </div>
</span></div>

<%- include("footer.ejs") -%>

<script>
   $(function(){
      $.stellar({
         horizontalScrolling: false,
         verticalOffset: 0,
         responsive: true
      });
   });
</script>
