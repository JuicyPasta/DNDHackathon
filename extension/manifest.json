{
    "manifest_version": 3,

    "name": "PASS2PolyRatings2",
    "description": "Link teacher names on PASS to PolyRatings.",
    "version": "5.0.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "icons": {
        "48": "logo48.png",
        "128": "logo128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://pass.calpoly.edu/main.html",
                "http://localhost/demo/pass.html"
            ],
            "js": ["thirdParty/jquery-2.2.3.min.js", "linker.js"],
            "css": ["thirdParty/bootstrap.min.css", "thirdParty/style.css"],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    }
}
